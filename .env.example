# ---- Required ---------------------------------------------------------------
PINECONE_API_KEY=pcsk_...          # vector storage AND embeddings (Pinecone inference)
GROQ_API_KEY=gsk_...               # LLM (default provider)

# ---- Optional: switch providers --------------------------------------------
# LLM_PROVIDER=groq                # groq | openai
# LLM_MODEL=openai/gpt-oss-120b    # Groq model id; use e.g. gpt-4o-mini with LLM_PROVIDER=openai
# LLM_TEMPERATURE=0.0
# EMBEDDING_PROVIDER=pinecone      # pinecone | openai
# EMBEDDING_MODEL=llama-text-embed-v2   # or text-embedding-3-small with EMBEDDING_PROVIDER=openai
# EMBEDDING_DIMENSION=1024              # 1536 for text-embedding-3-small; index is created with this size
# OPENAI_API_KEY=sk-...            # only when either provider is set to openai

# ---- Pinecone ---------------------------------------------------------------
# PINECONE_INDEX_NAME=agentic-ai-ebook
# PINECONE_NAMESPACE=ebook-v1
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# ---- Retrieval --------------------------------------------------------------
# TOP_K=5
# RELEVANCE_THRESHOLD=0.25         # cosine similarity gate; below this -> "not in knowledge base"
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150

# ---- Knowledge base ---------------------------------------------------------
# PDF_PATH=data/Ebook-Agentic-AI.pdf
# PDF_URL=https://konverge.ai/pdf/Ebook-Agentic-AI.pdf
